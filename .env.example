# RESET WEEK — Firebase Realtime Sync Configuration
# Add these in your local .env or in Vercel Dashboard > Project Settings > Environment Variables
# to automatically keep all your devices synced in real time.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SYNC_KEY=personal_reset_week
